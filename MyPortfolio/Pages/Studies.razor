@page "/studies"
@using MudBlazor

<PageTitle>Studies | Georgios Dimopoulos</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="portfolio-page studies-page">
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Class="studies-profile pa-5">
            <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="3">
                <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large" Class="studies-avatar">
                    <MudText Typo="Typo.h5">GD</MudText>
                </MudAvatar>
                <MudStack Spacing="1">
                    <MudText Typo="Typo.overline" Class="studies-eyebrow">DEVELOPER PROFILE / LEARNING</MudText>
                    <MudText Typo="Typo.h3" Class="studies-title">Studies &amp; Languages</MudText>
                    <MudText Typo="Typo.body1" Class="studies-intro">What I studied, where I studied, and how I keep learning with others.</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Class="studies-overview pa-4">
            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">1</MudText>
                        <MudText Typo="Typo.caption">Studying field</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">2</MudText>
                        <MudText Typo="Typo.caption">Universities</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">3–4</MudText>
                        <MudText Typo="Typo.caption">3 Hackathons</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">Multiple</MudText>
                        <MudText Typo="Typo.caption">side projects</MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudStack Spacing="2">
                    <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">Education</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">Studies &amp; projects</MudChip>
                    </MudStack>

                    <MudPaper Elevation="0" Class="studies-record studies-record-featured pa-4">
                        <MudStack Spacing="2">
                            <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success">Degree</MudChip>
                                <MudText Typo="Typo.caption">2014 — 2019</MudText>
                            </MudStack>
                            <MudStack Direction="Row" AlignItems="AlignItems.Start" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Success" Size="Size.Large" />
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.h6">Bachelor &amp; Master in Software Engineering</MudText>
                                    <MudText Typo="Typo.body2" Class="studies-secondary">Informatics · University of the Aegean</MudText>
                                </MudStack>
                            </MudStack>
                            <MudText Typo="Typo.body2">Studies in software engineering, alongside practical team projects and events with the wider technology community.</MudText>
                            <MudPaper Elevation="0" Class="studies-projects pa-2">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2" Class="studies-eyebrow">Tools &amp; Programing languages</MudText>
                                    <ul class="studies-list">
                                        <li><b>Lessons:</b> Discrete Mathematics, Computer Science &amp; Communications,
                                            Logic Design, Calculus, Physics I, Physics II, Databases I, Databases,
                                            Databases II, Linear Algebra, Circuit Theory, Programming Methodologies
                                            &amp; Languages, Probability &amp; Statistics, Java Programming, Computer
                                            Architecture – Assembly, IT Project Management, Data Structures, Signals
                                            &amp; Systems, Stochastic Analysis, Sets &amp; Numbers, Algorithms &amp;
                                            Complexity, Analysis &amp; Design, Differential Equations, Computer
                                            Communications, Advanced Topics in Programming Languages, Computer Networks,
                                            Theory of Computation, Business Operations, Software Technology,
                                            Telecommunications, Security, Systems Administration, Distributed Systems,
                                        Legal Framework, Internet Programming, Artificial Intelligence</li>
                                        <li><b>Languages:</b> Java, C#, C++, HTML, CSS, Xamarin Android, Assembly, C
                                        </li>
                                        <li><b>Individual projects during my studies:</b> Scrabble, Calculator, Currency
                                        Converter, Bingo Game</li>
                                    </ul>
                                </MudStack>
                            </MudPaper>
                            <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Samos, Greece</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Class="studies-record pa-4">
                        <MudStack Spacing="2">
                            <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.caption">2013 — 2014 · 2 semesters</MudText>
                            </MudStack>
                            <MudStack Direction="Row" AlignItems="AlignItems.Start" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Public" Color="Color.Success" Size="Size.Large" />
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.h6">Informatics</MudText>
                                    <MudText Typo="Typo.body2" Class="studies-secondary">University of Stuttgart · Vaihingen</MudText>
                                    <MudPaper Elevation="0" Class="studies-projects pa-2">
                                        <MudText Typo="Typo.body2" Class="studies-secondary"><b>Lessons:</b>
                                            Programmierung, Physik 1, ElektroTechnische GL, DatenStrukturen und
                                        Algorithmen, Höhere Mathematik 1</MudText>
                                    </MudPaper>
                                </MudStack>
                            </MudStack>
                            <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Stuttgart, Germany</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudStack Spacing="2">
                    <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">Languages</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">Proficiency</MudChip>
                    </MudStack>
                    <MudPaper Elevation="0" Class="studies-language pa-4">
                        <MudStack Spacing="1" AlignItems="AlignItems.Center">
                            <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.h6">German · TestDaF</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success">C1</MudChip>
                            </MudStack>
                            <MudText Typo="Typo.body2">Spoken for 6 months at Volke Consulting GmbH</MudText>
                            <MudText Typo="Typo.body2">Spoken for 2 years at TSG Solutions Group</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">TestDaF</MudChip>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Class="studies-language pa-4">
                        <MudStack Spacing="1" AlignItems="AlignItems.Center">
                            <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.h6">English · Cambridge FCE</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success">B2</MudChip>
                            </MudStack>
                            <MudText Typo="Typo.body2">Spoken fluently for 2 years at Grenzebach GmbH</MudText>
                            <MudText Typo="Typo.body2">Spoken fluently for 2 years at TSG Solutions Group</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">FCE</MudChip>
                        </MudStack>
                    </MudPaper>

                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="studies-learning-note">
                        <MudText Typo="Typo.subtitle2">Learning by doing</MudText>
                        <MudText Typo="Typo.body2">Team projects and real-world collaboration have been an important part of my education.</MudText>
                    </MudAlert>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudStack Spacing="2">
                    <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">Hackathons &amp; Summits</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">5 events</MudChip>
                    </MudStack>

                    <MudPaper Elevation="0" Class="studies-event pa-3">
                        <div class="event-head">
                            <span class="event-title">Orderify</span>
                            <span class="event-year">2015–2019</span>
                        </div>
                        <div class="event-meta">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                            <span>Athens</span>
                        </div>
                        <p class="event-text">Team project for food and drink retailers. My part: the owner's mobile and desktop applications, where the user manages the shop.</p>
                        <div class="event-tags">
                            <span class="event-tag">Xamarin Forms</span>
                            <span class="event-tag">WPF</span>
                            <span class="event-tag">.NET</span>
                        </div>
                    </MudPaper>
                    <MudPaper Elevation="0" Class="studies-event pa-3">
                        <div class="event-head">
                            <span class="event-title">StartHack Hackathon</span>
                            <span class="event-year">2017</span>
                        </div>
                        <div class="event-meta">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                            <span>Saint Gallen</span>
                            <span class="event-award">🏆 2nd place · Game Development Challenge by Logitech</span>
                        </div>
                        <p class="event-text">Team project: a game deployed on Unity and .NET platforms, where a driver had to avoid bombs on a custom map.</p>
                        <div class="event-tags">
                            <span class="event-tag">Unity</span>
                            <span class="event-tag">.NET</span>
                        </div>
                    </MudPaper>
                    <MudPaper Elevation="0" Class="studies-event pa-3">
                        <div class="event-head">
                            <span class="event-title">Orderify Plus</span>
                            <span class="event-year">2017</span>
                        </div>
                        <div class="event-meta">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                            <span>Web Summit Lisbon</span>
                            <span class="event-award">🏆 Top 500 Start-Ups</span>
                        </div>
                        <p class="event-text">Team project offering part-time job opportunities to students. My role: the UI of both applications, for owners and candidate employees.</p>
                        <div class="event-tags">
                            <span class="event-tag">Xamarin Android</span>
                            <span class="event-tag">.NET</span>
                        </div>
                    </MudPaper>
                    <MudPaper Elevation="0" Class="studies-event pa-3">
                        <div class="event-head">
                            <span class="event-title">Emergy</span>
                            <span class="event-year">2017</span>
                        </div>
                        <div class="event-meta">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                            <span>Athens · Crowdpolicy's Hackathon</span>
                        </div>
                        <p class="event-text">Platform where a citizen sends a single GPS signal in case of emergency. My part: the platform for the services (Police, Fire Service etc.).</p>
                        <div class="event-tags">
                            <span class="event-tag">WPF</span>
                            <span class="event-tag">.NET</span>
                        </div>
                    </MudPaper>
                    <MudPaper Elevation="0" Class="studies-event pa-3">
                        <div class="event-head">
                            <span class="event-title">Microsoft Candidate Student Partner</span>
                        </div>
                        <div class="event-meta">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                            <span>Student programme</span>
                        </div>
                        <p class="event-text">Presentations and small projects together with other candidates.</p>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudButton Href="/work" Variant="Variant.Outlined" Color="Color.Success" EndIcon="@Icons.Material.Filled.ArrowForward" Class="studies-next-link">Where I’ve worked</MudButton>
    </MudStack>
</MudContainer>
