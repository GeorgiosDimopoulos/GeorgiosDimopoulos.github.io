@page "/studies"
@using System.Text.Json
@using MudBlazor
@using MyPortfolio.Models
@using MyPortfolio.Services

@inject IStudiesService StudiesService

<PageTitle>Studies | Georgios Dimopoulos</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="portfolio-page studies-page">
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Class="studies-profile pa-5">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large" Class="studies-avatar">
                    <MudText Typo="Typo.h5">GD</MudText>
                </MudAvatar>
                <MudStack Spacing="1">
                    <MudText Typo="Typo.overline" Class="studies-eyebrow">DEVELOPER PROFILE / LEARNING</MudText>
                    <MudText Typo="Typo.h3" Class="studies-title">Studies &amp; Languages</MudText>
                    <MudText Typo="Typo.body1" Class="studies-intro">What I studied, where I studied, and how I keep learning with others.</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Class="studies-overview pa-4">
            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">1</MudText>
                        <MudText Typo="Typo.caption">Field of study</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">2</MudText>
                        <MudText Typo="Typo.caption">Universities</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">3</MudText>
                        <MudText Typo="Typo.caption">Hackathons</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">Multiple</MudText>
                        <MudText Typo="Typo.caption">Side projects</MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error">Could not load this section.</MudAlert>
        }
        else if (_studies is null || _languages is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" md="8">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h5">Education</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">Studies &amp; projects</MudChip>
                        </MudStack>

                        @for (var i = 0; i < _studies.Count; i++)
                        {
                            var study = _studies[i];
                            var isFeatured = i == 0;

                            <MudPaper Elevation="0"
                                      Class="@(isFeatured ? "studies-record studies-record-featured pa-4" : "studies-record pa-4")">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        @if (study.Badge is not null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success">@study.Badge</MudChip>
                                        }
                                        <MudText Typo="Typo.caption">@FormatPeriod(study)</MudText>
                                    </MudStack>
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                        <MudIcon Icon="@(isFeatured ? Icons.Material.Filled.School : Icons.Material.Filled.Public)"
                                                 Color="Color.Success" Size="Size.Large" />
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.h6">@study.Title</MudText>
                                            <MudText Typo="Typo.body2" Class="studies-secondary">
                                                @(study.Department is null ? study.University : $"{study.Department} · {study.University}")
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                    @if (study.Description is not null)
                                    {
                                        <MudText Typo="Typo.body2">@study.Description</MudText>
                                    }
                                    <MudPaper Elevation="0" Class="studies-projects pa-2">
                                        <MudStack Spacing="1">
                                            @if (study.ProgrammingLanguages.Count > 0)
                                            {
                                                <MudText Typo="Typo.subtitle2" Class="studies-eyebrow">Tools &amp; Programming languages</MudText>
                                            }
                                            <ul class="studies-list">
                                                @if (study.Lessons.Count > 0)
                                                {
                                                    <li><b>Lessons:</b> @string.Join(", ", study.Lessons)</li>
                                                }
                                                @if (study.ProgrammingLanguages.Count > 0)
                                                {
                                                    <li><b>Languages:</b> @string.Join(", ", study.ProgrammingLanguages)</li>
                                                }
                                                @if (study.Projects.Count > 0)
                                                {
                                                    <li><b>Individual projects during my studies:</b> @string.Join(", ", study.Projects)</li>
                                                }
                                            </ul>
                                        </MudStack>
                                    </MudPaper>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Success" Size="Size.Small" />
                                        <MudText Typo="Typo.caption">@study.Location</MudText>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h5">Languages</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">Proficiency</MudChip>
                        </MudStack>

                        @foreach (var language in _languages)
                        {
                            <MudPaper Elevation="0" Class="studies-language pa-4">
                                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.h6">@language.Name · @language.Certificate</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success">@language.Level</MudChip>
                                    </MudStack>
                                    @foreach (var experience in language.Experiences)
                                    {
                                        <MudText Typo="Typo.body2">@experience</MudText>
                                    }
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">@language.Certificate</MudChip>
                                </MudStack>
                            </MudPaper>
                        }

                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="studies-learning-note">
                            <MudText Typo="Typo.subtitle2">Learning by doing</MudText>
                            <MudText Typo="Typo.body2">Team projects and real-world collaboration have been an important part of my education.</MudText>
                        </MudAlert>
                    </MudStack>
                </MudItem>
            </MudGrid>
        }

        <MudButton Href="/work" Variant="Variant.Outlined" Color="Color.Success" EndIcon="@Icons.Material.Filled.ArrowForward" Class="studies-next-link">Where I’ve worked</MudButton>
    </MudStack>
</MudContainer>


@code
{
    private bool _loadFailed;
    private IReadOnlyList<Study>? _studies;
    private IReadOnlyList<Language>? _languages;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _studies = await StudiesService.GetStudiesAsync();
            _languages = await StudiesService.GetLanguagesAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _loadFailed = true;
        }
    }

    private static string FormatPeriod(Study study)
    {
        var years = $"{study.StartYear} — {study.EndYear}";
        return study.Note is null ? years : $"{years} · {study.Note}";
    }
}
