@page "/work"
@using MudBlazor
@using System.Globalization
@using System.Text.Json
@using MyPortfolio.Models
@using MyPortfolio.Services

@inject IJobsService JobsService

<PageTitle>Work | Georgios Dimopoulos</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="portfolio-page work-page">
    <MudPaper Elevation="0" Class="w-100">
        <header class="work-header">
            <MudText Typo="Typo.h3" Class="mb-1">Work</MudText>
            <MudText Typo="Typo.subtitle1" Class="mb-4">Professional Experience</MudText>
        </header>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error">Could not load this section.</MudAlert>
        }
        else if (_jobs is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <div class="work-timeline">
                @for (var i = 0; i < _jobs.Count; i++)
                {
                    var job = _jobs[i];
                    <article class="work-experience work-tone-@(i % 4)">
                        <span class="work-dot" aria-hidden="true"></span>

                        <div class="work-head">
                            <h2 class="work-company">@job.Company</h2>
                            <span class="work-dates">@FormatPeriod(job)</span>
                        </div>
                        <div class="work-meta">@job.Location</div>
                        <p class="work-summary">@job.Summary</p>

                        @foreach (var role in job.Positions)
                        {
                            <section class="work-role">
                                <h3 class="work-role-title">
                                    @role.Title
                                    @if (role.DurationMonths is not null)
                                    {
                                        <span class="work-role-duration">@role.DurationMonths months</span>
                                    }
                                </h3>
                                <ul class="work-points">
                                    @foreach (var point in role.Points)
                                    {
                                        <li>@point</li>
                                    }
                                </ul>
                                <div class="work-tags">
                                    @foreach (var tag in role.Tags)
                                    {
                                        <span class="work-tag">@tag</span>
                                    }
                                </div>
                            </section>
                        }
                    </article>
                }
            </div>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _loadFailed;
    private IReadOnlyList<Job>? _jobs;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _jobs = await JobsService.GetJobsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _loadFailed = true;
        }
    }

    private static string FormatPeriod(Job job) =>
        $"{FormatMonth(job.StartDate)} – {(job.EndDate is { } end ? FormatMonth(end) : "Present")}";

    private static string FormatMonth(DateOnly date) =>
        date.ToString("MMM yyyy", CultureInfo.InvariantCulture);
}
