                        "UI: data grids, filters, sorting, dialogs, error handling and notifications",
                        "Small, isolated adjustments to a legacy production project"
                    },
                    new[] { ".NET", "Blazor", "REST APIs", "Integration Tests", "DataGrids", "Python" })
            }),

        new Job(
            "Volke Consulting Engineers", "BMW Group, Munich", "Feb 2024 – Jul 2024",
            "Technical development in automotive engineering. German-speaking position.",
            new[]
