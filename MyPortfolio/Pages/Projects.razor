@page "/projects"
@using MudBlazor
@using System.Text.Json
@using MyPortfolio.Models
@using MyPortfolio.Services

@inject IPortfolioService PortfolioService

<PageTitle>Projects | Georgios Dimopoulos</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="portfolio-page studies-page projects-page">
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Class="studies-profile pa-5">
            <MudText Typo="Typo.overline" Class="studies-eyebrow">BUILDING &amp; SHARING</MudText>
            <MudText Typo="Typo.h3" Class="studies-title">Projects</MudText>
            <MudText Typo="Typo.body1" Class="studies-intro">Side projects, hackathons and summits.</MudText>
        </MudPaper>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error">Could not load this section.</MudAlert>
        }
        else if (_projects is null || _events is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudPaper Elevation="0" Class="studies-projects projects-repos pa-4">
                <MudText Typo="Typo.subtitle2" Class="studies-eyebrow">Public GitHub projects</MudText>
                <ul class="studies-list">
                    @foreach (var project in _projects)
                    {
                        <li>
                            <a href="@project.RepoUrl" target="_blank" rel="noopener noreferrer">@project.Name</a>
                            <span class="repo-lang">@project.Tech</span>
                            <span class="repo-desc">@project.Description</span>
                        </li>
                    }
                </ul>
            </MudPaper>

            <MudButton Href="https://github.com/GeorgiosDimopoulos" Target="_blank" rel="noopener noreferrer"
                       Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" FullWidth="true"
                       StartIcon="@Icons.Custom.Brands.GitHub" Class="projects-github">
                See all my projects on GitHub
            </MudButton>

            <div class="projects-events">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.h5">Hackathons &amp; Summits</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                        @_events.Count events
                    </MudChip>
                </MudStack>
                <div class="events-grid">
                    @foreach (var techEvent in _events)
                    {
                        <MudPaper Elevation="0" Class="studies-event pa-3">
                            <div class="event-head">
                                <span class="event-title">@techEvent.Title</span>
                                @if (techEvent.Years is not null)
                                {
                                    <span class="event-year">@techEvent.Years</span>
                                }
                            </div>
                            <div class="event-meta">
                                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                                <span>@techEvent.Location</span>
                                @if (techEvent.Award is not null)
                                {
                                    <span class="event-award">🏆 @techEvent.Award</span>
                                }
                            </div>
                            <p class="event-text">@techEvent.Description</p>
                            @if (techEvent.Tags.Count > 0)
                            {
                                <div class="event-tags">
                                    @foreach (var tag in techEvent.Tags)
                                    {
                                        <span class="event-tag">@tag</span>
                                    }
                                </div>
                            }
                        </MudPaper>
                    }
                </div>
            </div>
        }
    </MudStack>
</MudContainer>

@code
{
    private bool _loadFailed;
    private IReadOnlyList<Project>? _projects;
    private IReadOnlyList<TechEvent>? _events;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _projects = await PortfolioService.GetProjectsAsync();
            _events = await PortfolioService.GetTechEventsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _loadFailed = true;
        }
    }
}
