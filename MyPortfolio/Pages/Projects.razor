@page "/projects"
@using MudBlazor

<PageTitle>Projects | Georgios Dimopoulos</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="portfolio-page studies-page projects-page">
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Class="studies-profile pa-5">
            <MudText Typo="Typo.overline" Class="studies-eyebrow">BUILDING &amp; SHARING</MudText>
            <MudText Typo="Typo.h3" Class="studies-title">Projects</MudText>
            <MudText Typo="Typo.body1" Class="studies-intro">Side projects, hackathons and summits.</MudText>
        </MudPaper>

        <MudPaper Elevation="0" Class="studies-projects projects-repos pa-4">
            <MudText Typo="Typo.subtitle2" Class="studies-eyebrow">Public GitHub projects</MudText>
            <ul class="studies-list">
                    <li><a href="https://github.com/GeorgiosDimopoulos/StelexarasApp" target="_blank" rel="noopener noreferrer">StelexarasApp</a> <span class="repo-lang">C#</span> – Mobile app</li>
                    <li><a href="https://github.com/GeorgiosDimopoulos/UEFA-Ranking-App" target="_blank" rel="noopener noreferrer">UEFA-Ranking-App</a> <span class="repo-lang">C#</span> – UEFA rankings app</li>
                    <li><a href="https://github.com/GeorgiosDimopoulos/Emergy" target="_blank" rel="noopener noreferrer">Emergy</a> <span class="repo-lang">Java</span> – SOS application (Xamarin Forms) for users who get lost, with a municipal-service application (WPF) to find them</li>
                    <li><a href="https://github.com/GeorgiosDimopoulos/Thesis" target="_blank" rel="noopener noreferrer">Thesis</a> <span class="repo-lang">Jupyter Notebook</span> – University thesis</li>
                    <li><a href="https://github.com/GeorgiosDimopoulos/My-Calculator" target="_blank" rel="noopener noreferrer">My-Calculator</a> <span class="repo-lang">C#</span> – Calculator app for Android devices</li>
                    <li><a href="https://github.com/GeorgiosDimopoulos/Game-Of-Chance" target="_blank" rel="noopener noreferrer">Game-Of-Chance</a> <span class="repo-lang">C#</span> – My first attempt at creating a simple game of chance</li>
                    <li><a href="https://github.com/GeorgiosDimopoulos/MyEncryptedMessaging" target="_blank" rel="noopener noreferrer">MyEncryptedMessaging</a> <span class="repo-lang">C#</span> – Encrypted messaging attempt</li>
                    <li><a href="https://github.com/GeorgiosDimopoulos/ARTestScene" target="_blank" rel="noopener noreferrer">ARTestScene</a> <span class="repo-lang">ShaderLab</span> – Markerless AR scene in Unity</li>
            </ul>
        </MudPaper>

        <MudButton Href="https://github.com/GeorgiosDimopoulos" Target="_blank" rel="noopener noreferrer"
                   Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" FullWidth="true"
                   StartIcon="@Icons.Custom.Brands.GitHub" Class="projects-github">
            See all my projects on GitHub
        </MudButton>

        <div class="projects-events">
            <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.h5">Hackathons &amp; Summits</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">5 events</MudChip>
            </MudStack>
            <div class="events-grid">
                <MudPaper Elevation="0" Class="studies-event pa-3">
                    <div class="event-head">
                        <span class="event-title">Orderify</span>
                        <span class="event-year">2015–2019</span>
                    </div>
                    <div class="event-meta">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                        <span>Athens</span>
                    </div>
                    <p class="event-text">Team project for food and drink retailers. My part: the owner's mobile and desktop applications, where the user manages the shop.</p>
                    <div class="event-tags">
                        <span class="event-tag">Xamarin Forms</span>
                        <span class="event-tag">WPF</span>
                        <span class="event-tag">.NET</span>
                    </div>
                </MudPaper>
                <MudPaper Elevation="0" Class="studies-event pa-3">
                    <div class="event-head">
                        <span class="event-title">StartHack Hackathon</span>
                        <span class="event-year">2017</span>
                    </div>
                    <div class="event-meta">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                        <span>Saint Gallen</span>
                        <span class="event-award">🏆 2nd place · Game Development Challenge by Logitech</span>
                    </div>
                    <p class="event-text">Team project: a game deployed on Unity and .NET platforms, where a driver had to avoid bombs on a custom map.</p>
                    <div class="event-tags">
                        <span class="event-tag">Unity</span>
                        <span class="event-tag">.NET</span>
                    </div>
                </MudPaper>
                <MudPaper Elevation="0" Class="studies-event pa-3">
                    <div class="event-head">
                        <span class="event-title">Orderify Plus</span>
                        <span class="event-year">2017</span>
                    </div>
                    <div class="event-meta">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                        <span>Web Summit Lisbon</span>
                        <span class="event-award">🏆 Top 500 Start-Ups</span>
                    </div>
                    <p class="event-text">Team project offering part-time job opportunities to students. My role: the UI of both applications, for owners and candidate employees.</p>
                    <div class="event-tags">
                        <span class="event-tag">Xamarin Android</span>
                        <span class="event-tag">.NET</span>
                    </div>
                </MudPaper>
                <MudPaper Elevation="0" Class="studies-event pa-3">
                    <div class="event-head">
                        <span class="event-title">Emergy</span>
                        <span class="event-year">2017</span>
                    </div>
                    <div class="event-meta">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                        <span>Athens · Crowdpolicy's Hackathon</span>
                    </div>
                    <p class="event-text">Platform where a citizen sends a single GPS signal in case of emergency. My part: the platform for the services (Police, Fire Service etc.).</p>
                    <div class="event-tags">
                        <span class="event-tag">WPF</span>
                        <span class="event-tag">.NET</span>
                    </div>
                </MudPaper>
                <MudPaper Elevation="0" Class="studies-event pa-3">
                    <div class="event-head">
                        <span class="event-title">Microsoft Candidate Student Partner</span>
                    </div>
                    <div class="event-meta">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                        <span>Student programme</span>
                    </div>
                    <p class="event-text">Presentations and small projects together with other candidates.</p>
                </MudPaper>
            </div>
        </div>
    </MudStack>
</MudContainer>
