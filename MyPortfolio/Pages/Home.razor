@page "/"

@using MudBlazor
@inherits LayoutComponentBase
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.False" Class="home-full">
    <div class="home-intro">
        <MudImage Src="images/me.jpg" Fallback="images/profile-placeholder.svg"
                  Alt="Georgios Dimopoulos" Class="home-photo" ObjectFit="ObjectFit.Cover" />
        <div class="home-details">
            <MudText Typo="Typo.h6" Class="font-semibold">Software developer</MudText>
            <MudText Typo="Typo.h6" Class="font-semibold">33 years old</MudText>
            <MudText Typo="Typo.h6" Class="font-semibold">Munich, Germany</MudText>
        </div>
    </div>
    <div class="home-tiles">
        <div class="home-tile">
            <MudButton Style="width:100%;
                height:100%;
                background-image:
                linear-gradient(rgba(10, 30, 60, 0.35), rgba(10, 30, 60, 0.35)), url('images/work.png');
                filter:brightness(1.2);
                background-size:cover;
                background-position:center;
                color:white;"
                       OnClick="@OnWork">
                <MudText Typo="Typo.h4" Class="home-tile-title">WORK</MudText>
            </MudButton>
        </div>
        <div class="home-tile">
            <MudButton Style="width:100%;
                height:100%;
                background-image: linear-gradient(rgba(10, 30, 60, 0.35), rgba(10, 30, 60, 0.35)), url('images/code.png');
                filter:brightness(1.2);
                background-size:cover;
                background-position:center;
                color:white;"
                       OnClick="@OnProjects">
                <MudText Typo="Typo.h4" Class="home-tile-title">PROJECTS</MudText>
            </MudButton>
        </div>
        <div class="home-tile">
            <MudButton Style="width:100%;
                height:100%;
                background-image: linear-gradient(rgba(10, 30, 60, 0.35), rgba(10, 30, 60, 0.35)), url('images/uni.png');
                filter:brightness(1.2);
                background-size:cover;
                background-position:center;
                color:white;"
                       OnClick="@OnStudies">
                <MudText Typo="Typo.h4" Class="home-tile-title">STUDIES</MudText>
            </MudButton>
        </div>
        <div class="home-tile">
            <MudButton Style="width:100%;
                height:100%;
                background-image: linear-gradient(rgba(10, 30, 60, 0.35), rgba(10, 30, 60, 0.35)), url('images/park.png');
                filter:brightness(1.2);
                background-size:cover;
                background-position:center;
                color:white;"
                       OnClick="@OnLife">
                <MudText Typo="Typo.h4" Class="home-tile-title">LIFE</MudText>
            </MudButton>
        </div>
    </div>
</MudContainer>

@code {
    private void OnStudies()
    {
        Nav.NavigateTo("/studies");
    }

    private void OnProjects()
    {
        Nav.NavigateTo("/projects");
    }

    private void OnWork()
    {
        Nav.NavigateTo("/work");
    }

    private void OnLife()
    {
        Nav.NavigateTo("/life");
    }
}