@page "/"

@using MudBlazor
@inherits LayoutComponentBase
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.False" Class="home-full" Style="padding:0;height:calc(100vh - 64px); display:flex; flex-direction:column">
    <div class="home-intro">
        <MudImage Src="images/me.jpg" Fallback="images/profile-placeholder.svg"
                  Alt="Georgios Dimopoulos" Class="home-photo" ObjectFit="ObjectFit.Cover" />
        <MudText Typo="Typo.h6" Class="font-semibold">Software developer</MudText>
        <MudText Typo="Typo.h6" Class="font-semibold">33 years old</MudText>
        <MudText Typo="Typo.h6" Class="font-semibold">Munich, Germany</MudText>
    </div>
    <div class="home-tiles">
        <div class="home-tile">
            <MudButton Style="width:100%;
                height:100%;
                background-image:
                linear-gradient(rgba(173, 216, 230, 0.45), rgba(173, 216, 230, 0.45)), url('images/work.png');
                filter:brightness(1.2);
                background-size:cover;
                background-position:center;
                color:white;"
                       OnClick="@OnWork">
                WORK
            </MudButton>
        </div>
        <div class="home-tile">
            <MudButton Style="width:100%;
                height:100%;
                background-image: linear-gradient(rgba(173, 216, 230, 0.45), rgba(173, 216, 230, 0.45)), url('images/code.png');
                filter:brightness(1.2);
                background-size:cover;
                background-position:center;
                color:white;"
                       OnClick="@OnProjects">
                Projects
            </MudButton>
        </div>
        <div class="home-tile">
            <MudButton Style="width:100%;
                height:100%;
                background-image: linear-gradient(rgba(173, 216, 230, 0.45), rgba(173, 216, 230, 0.45)), url('images/uni.png');
                filter:brightness(1.2);
                background-size:cover;
                background-position:center;
                color:white;"
                       OnClick="@OnStudies">
                STUDIES
            </MudButton>
        </div>
        <div class="home-tile">
            <MudButton Style="width:100%;
                height:100%;
                background-image: linear-gradient(rgba(173, 216, 230, 0.45), rgba(173, 216, 230, 0.45)), url('images/park.png');
                filter:brightness(1.2);
                background-size:cover;
                background-position:center;
                color:white;"
                       OnClick="@OnLife">
                LIFE
            </MudButton>
        </div>
    </div>
</MudContainer>

@code {
    private void OnStudies()
    {
        Nav.NavigateTo("/studies");
    }

    private void OnProjects()
    {
        Nav.NavigateTo("/projects");
    }

    private void OnWork()
    {
        Nav.NavigateTo("/work");
    }

    private void OnLife()
    {
        Nav.NavigateTo("/life");
    }
}